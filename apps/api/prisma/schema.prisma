generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String       @id @default(cuid())
  googleSubject String       @unique
  email         String       @unique
  displayName   String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  userProfile   UserProfile? @relation("UserProfile")
}

model UserProfile {
  id                           String                @id @default(cuid())
  userId                       String?               @unique
  displayName                  String
  preferredReadingLevel        String                @default("simple")
  chunkMasteryThreshold        Int                   @default(80)
  finalSummaryMasteryThreshold Int                   @default(80)
  user                         User?                 @relation("UserProfile", fields: [userId], references: [id])
  materials                    Material[]
  routingPreferences           AiRoutingPreference[]
  createdAt                    DateTime              @default(now())
  updatedAt                    DateTime              @updatedAt
}

model Material {
  id             String              @id @default(cuid())
  userProfileId  String
  title          String
  originalText   String
  status         String              @default("notStarted")
  finalBestScore Int?
  userProfile    UserProfile         @relation(fields: [userProfileId], references: [id])
  chunks         MaterialChunk[]
  attempts       ParaphraseAttempt[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

model MaterialChunk {
  id         String              @id @default(cuid())
  materialId String
  index      Int
  text       String
  status     String              @default("notStarted")
  bestScore  Int?
  material   Material            @relation(fields: [materialId], references: [id])
  attempts   ParaphraseAttempt[]

  @@unique([materialId, index])
}

model ParaphraseAttempt {
  id         String         @id @default(cuid())
  materialId String
  chunkId    String?
  scope      String
  transcript String
  score      Int
  passed     Boolean
  rubricJson String
  feedback   String
  material   Material       @relation(fields: [materialId], references: [id])
  chunk      MaterialChunk? @relation(fields: [chunkId], references: [id])
  createdAt  DateTime       @default(now())
}

model AiRoutingPreference {
  id            String      @id @default(cuid())
  userProfileId String
  capability    String
  provider      String
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id])

  @@unique([userProfileId, capability])
}
