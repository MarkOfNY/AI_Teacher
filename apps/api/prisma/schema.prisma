generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(cuid())
  googleSubject  String          @unique
  email          String          @unique
  displayName    String
  role           String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  studentProfile StudentProfile? @relation("StudentUser")
  parentLinks    ParentStudent[] @relation("ParentLinks")
}

model ParentStudent {
  id        String         @id @default(cuid())
  parentId  String
  studentId String
  parent    User           @relation("ParentLinks", fields: [parentId], references: [id])
  student   StudentProfile @relation(fields: [studentId], references: [id])
  createdAt DateTime       @default(now())

  @@unique([parentId, studentId])
}

model StudentProfile {
  id                           String                @id @default(cuid())
  userId                       String?               @unique
  displayName                  String
  preferredReadingLevel        String                @default("simple")
  chunkMasteryThreshold        Int                   @default(80)
  finalSummaryMasteryThreshold Int                   @default(80)
  user                         User?                 @relation("StudentUser", fields: [userId], references: [id])
  parentLinks                  ParentStudent[]
  materials                    Material[]
  routingPreferences           AiRoutingPreference[]
  createdAt                    DateTime              @default(now())
  updatedAt                    DateTime              @updatedAt
}

model Material {
  id               String              @id @default(cuid())
  studentProfileId String
  title            String
  originalText     String
  status           String              @default("notStarted")
  finalBestScore   Int?
  studentProfile   StudentProfile      @relation(fields: [studentProfileId], references: [id])
  chunks           MaterialChunk[]
  attempts         ParaphraseAttempt[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
}

model MaterialChunk {
  id         String              @id @default(cuid())
  materialId String
  index      Int
  text       String
  status     String              @default("notStarted")
  bestScore  Int?
  material   Material            @relation(fields: [materialId], references: [id])
  attempts   ParaphraseAttempt[]

  @@unique([materialId, index])
}

model ParaphraseAttempt {
  id         String         @id @default(cuid())
  materialId String
  chunkId    String?
  scope      String
  transcript String
  score      Int
  passed     Boolean
  rubricJson String
  feedback   String
  material   Material       @relation(fields: [materialId], references: [id])
  chunk      MaterialChunk? @relation(fields: [chunkId], references: [id])
  createdAt  DateTime       @default(now())
}

model AiRoutingPreference {
  id               String         @id @default(cuid())
  studentProfileId String
  capability       String
  provider         String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id])

  @@unique([studentProfileId, capability])
}
